# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Never prefix with NEXT_PUBLIC_ and never use in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Where the app is hosted (used in invite links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# n8n integration (see README section 7)
# Long random string (openssl rand -hex 32); n8n sends it in the x-api-key header to POST /api/leads.
# Leave empty to turn the API off.
LEADS_API_KEY=
# Optional. If set, every stage change is POSTed here.
WEBHOOK_URL=
